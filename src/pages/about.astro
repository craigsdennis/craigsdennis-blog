---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Developer educator, AI enthusiast, and creative technologist." />
	</head>
	<body>
		<Header />
		<main>
			<article class="about">
				<header class="about-header">
					<span class="breadcrumb">
						<span class="prompt">$</span> cat about.md
					</span>
					<h1>About Me</h1>
				</header>
				
				<div class="about-content">
					<section class="intro">
						<p class="lead">
							Hey! I'm <strong>Craig Dennis</strong> - a developer educator who believes 
							complex things can (and should) be made approachable.
						</p>
						
						<p>
							I spend my days teaching developers how to build with AI, creating tutorials, 
							and hosting <a href={SOCIAL_LINKS.aiavenue} target="_blank" rel="noopener">AI Avenue</a> - 
							a show that explores the good, bad, and ethically-messy of artificial intelligence.
						</p>
					</section>
					
					<section class="what-i-do">
						<h2>What I'm Into</h2>
						
						<div class="interests-grid">
							<div class="interest-card">
								<span class="interest-icon">ai</span>
								<h3>AI & Machine Learning</h3>
								<p>Teaching machines (and humans) how to work together. Building tools that make AI accessible to every developer.</p>
							</div>
							
							<div class="interest-card">
								<span class="interest-icon">{"</>"}</span>
								<h3>Developer Education</h3>
								<p>Creating tutorials, courses, and content that breaks down complex topics into digestible pieces.</p>
							</div>
							
							<div class="interest-card">
								<span class="interest-icon">~</span>
								<h3>Music & Audio</h3>
								<p>Making noise with code, exploring the intersection of technology and sound.</p>
							</div>
							
							<div class="interest-card">
								<span class="interest-icon">*</span>
								<h3>Creative Tech</h3>
								<p>AI generations, experiments, and breaking things in beautiful ways.</p>
							</div>
						</div>
					</section>
					
					<section class="find-me">
						<h2>Find Me Online</h2>
						<p>I'm <code>@craigsdennis</code> on most platforms:</p>
						
						<ul class="social-list">
							<li>
								<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">
									<span class="social-label">GitHub</span>
									<span class="social-handle">@craigsdennis</span>
								</a>
							</li>
							<li>
								<a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener">
									<span class="social-label">YouTube</span>
									<span class="social-handle">@craigsdennis</span>
								</a>
							</li>
							<li>
								<a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener">
									<span class="social-label">X (Twitter)</span>
									<span class="social-handle">@craigsdennis</span>
								</a>
							</li>
							<li>
								<a href={SOCIAL_LINKS.aiavenue} target="_blank" rel="noopener" class="featured">
									<span class="social-label">AI Avenue</span>
									<span class="social-handle">aiavenue.show</span>
								</a>
							</li>
						</ul>
					</section>
					
					<section class="this-site">
						<h2>About This Site</h2>
						<p>
							This blog is where I share thoughts on AI, development, music, and whatever 
							else I'm exploring. It's built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 
							and deployed on <a href="https://cloudflare.com" target="_blank" rel="noopener">Cloudflare</a>.
						</p>
					</section>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 800px;
	}
	
	.about {
		animation: fadeIn 0.6s ease;
	}
	
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}
	
	.about-header {
		margin-bottom: var(--space-xl);
	}
	
	.breadcrumb {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
		display: block;
		margin-bottom: var(--space-sm);
	}
	
	.breadcrumb .prompt {
		color: var(--accent-cyan);
		font-weight: bold;
	}
	
	.about-content section {
		margin-bottom: var(--space-xl);
	}
	
	.about-content h2 {
		margin-bottom: var(--space-md);
		padding-bottom: var(--space-sm);
		border-bottom: 1px solid var(--border-subtle);
	}
	
	/* Intro */
	.lead {
		font-size: 1.3rem;
		color: var(--text-primary);
		line-height: 1.6;
	}
	
	.intro p {
		color: var(--text-secondary);
		line-height: 1.8;
	}
	
	.intro a {
		color: var(--accent-amber);
		font-weight: 600;
	}
	
	.intro a:hover {
		color: var(--accent-pink);
	}
	
	/* Interests Grid */
	.interests-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-md);
	}
	
	.interest-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		padding: var(--space-lg);
		transition: all var(--transition-base);
	}
	
	.interest-card:hover {
		border-color: var(--accent-cyan-dim);
		transform: translateY(-2px);
	}
	
	.interest-icon {
		font-family: var(--font-mono);
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--accent-cyan);
		display: block;
		margin-bottom: var(--space-sm);
	}
	
	.interest-card h3 {
		font-size: 1rem;
		margin-bottom: var(--space-xs);
	}
	
	.interest-card p {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin: 0;
		line-height: 1.6;
	}
	
	/* Social List */
	.social-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}
	
	.social-list li a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--space-md) var(--space-lg);
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		text-decoration: none;
		transition: all var(--transition-fast);
	}
	
	.social-list li a:hover {
		border-color: var(--accent-cyan-dim);
		background: var(--bg-tertiary);
	}
	
	.social-list li a.featured {
		border-color: var(--accent-amber-dim);
		background: rgba(240, 160, 0, 0.05);
	}
	
	.social-list li a.featured:hover {
		border-color: var(--accent-amber);
	}
	
	.social-label {
		font-weight: 600;
		color: var(--text-primary);
	}
	
	.social-handle {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	
	.social-list li a:hover .social-handle {
		color: var(--accent-cyan);
	}
	
	.social-list li a.featured .social-handle {
		color: var(--accent-amber);
	}
	
	/* This Site */
	.this-site p {
		color: var(--text-secondary);
		line-height: 1.8;
	}
	
	.this-site a {
		color: var(--accent-cyan);
	}
	
	.this-site a:hover {
		color: var(--accent-amber);
	}
	
	.about-content code {
		background: var(--bg-tertiary);
		color: var(--accent-cyan);
	}
	
	/* Responsive */
	@media (max-width: 720px) {
		.lead {
			font-size: 1.1rem;
		}
		
		.interests-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
