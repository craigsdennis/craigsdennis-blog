---
import { SOCIAL_LINKS } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="footer-main">
			<div class="terminal-prompt">
				<span class="prompt-symbol">$</span>
				<span class="prompt-text">echo "Thanks for visiting"</span>
				<span class="cursor"></span>
			</div>
			
			<div class="footer-links">
				<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">GitHub</a>
				<span class="separator">/</span>
				<a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener">YouTube</a>
				<span class="separator">/</span>
				<a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener">X</a>
				<span class="separator">/</span>
				<a href={SOCIAL_LINKS.aiavenue} target="_blank" rel="noopener" class="highlight">AI Avenue</a>
			</div>
		</div>
		
		<div class="footer-bottom">
			<p class="copyright">
				&copy; {today.getFullYear()} Craig Dennis
			</p>
			<p class="made-with">
				Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> & curiosity
			</p>
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: auto;
		border-top: 1px solid var(--border-color);
		background: var(--bg-secondary);
	}
	
	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: var(--space-xl) var(--space-lg);
	}
	
	.footer-main {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-lg);
		margin-bottom: var(--space-xl);
	}
	
	.terminal-prompt {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	
	.prompt-symbol {
		color: var(--accent-cyan);
		font-weight: bold;
	}
	
	.prompt-text {
		color: var(--text-muted);
	}
	
	.cursor {
		width: 0.5em;
		height: 1em;
		background: var(--accent-amber);
		animation: blink 1s step-end infinite;
	}
	
	@keyframes blink {
		0%, 50% { opacity: 1; }
		51%, 100% { opacity: 0; }
	}
	
	.footer-links {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	
	.footer-links a {
		color: var(--text-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
		padding: 0.25em 0.5em;
	}
	
	.footer-links a:hover {
		color: var(--accent-cyan);
	}
	
	.footer-links a.highlight {
		color: var(--accent-amber);
	}
	
	.footer-links a.highlight:hover {
		color: var(--accent-pink);
	}
	
	.separator {
		color: var(--border-color);
	}
	
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: var(--space-lg);
		border-top: 1px solid var(--border-subtle);
	}
	
	.copyright, .made-with {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0;
	}
	
	.made-with a {
		color: var(--accent-cyan-dim);
	}
	
	.made-with a:hover {
		color: var(--accent-cyan);
	}
	
	@media (max-width: 720px) {
		.footer-content {
			padding: var(--space-lg) var(--space-md);
			padding-bottom: calc(var(--space-lg) + 60px); /* Account for fixed nav */
		}
		
		.footer-bottom {
			flex-direction: column;
			gap: var(--space-sm);
			text-align: center;
		}
		
		.footer-links {
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>
