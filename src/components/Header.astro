---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo">
			<span class="logo-text">{SITE_TITLE}</span>
			<span class="cursor"></span>
		</a>
		
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		
		<div class="social-links">
			<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener" title="GitHub">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path fill="currentColor" d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
				</svg>
			</a>
			<a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener" title="YouTube">
				<span class="sr-only">YouTube</span>
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
				</svg>
			</a>
			<a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener" title="X (Twitter)">
				<span class="sr-only">X (Twitter)</span>
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<a href={SOCIAL_LINKS.aiavenue} target="_blank" rel="noopener" title="AI Avenue" class="aiavenue-link">
				<span class="sr-only">AI Avenue</span>
				<span class="aiavenue-badge">AI Ave</span>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(13, 17, 23, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border-color);
	}
	
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 var(--space-lg);
		height: 64px;
	}
	
	.logo {
		display: flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		text-decoration: none;
		transition: color var(--transition-fast);
	}
	
	.logo:hover {
		color: var(--accent-cyan);
	}
	
	.logo:hover .cursor {
		background: var(--accent-cyan);
	}
	
	.cursor {
		display: inline-block;
		width: 0.5em;
		height: 1.1em;
		background: var(--accent-amber);
		margin-left: 2px;
		animation: blink 1s step-end infinite;
	}
	
	@keyframes blink {
		0%, 50% { opacity: 1; }
		51%, 100% { opacity: 0; }
	}
	
	.nav-links {
		display: flex;
		gap: var(--space-xs);
	}
	
	.social-links {
		display: flex;
		align-items: center;
		gap: var(--space-md);
	}
	
	.social-links a {
		color: var(--text-secondary);
		transition: all var(--transition-fast);
		display: flex;
		align-items: center;
	}
	
	.social-links a:hover {
		color: var(--accent-cyan);
		transform: translateY(-2px);
	}
	
	.aiavenue-badge {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.3em 0.6em;
		background: linear-gradient(135deg, var(--accent-amber) 0%, var(--accent-pink) 100%);
		color: var(--bg-primary);
		border-radius: 4px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	
	.aiavenue-link:hover .aiavenue-badge {
		box-shadow: var(--glow-amber);
	}
	
	@media (max-width: 720px) {
		nav {
			padding: 0 var(--space-md);
		}
		
		.nav-links {
			position: fixed;
			bottom: 0;
			left: 0;
			right: 0;
			background: rgba(13, 17, 23, 0.95);
			backdrop-filter: blur(12px);
			border-top: 1px solid var(--border-color);
			padding: var(--space-sm) var(--space-md);
			justify-content: center;
			gap: var(--space-md);
			z-index: 100;
		}
		
		.social-links {
			gap: var(--space-sm);
		}
		
		.aiavenue-badge {
			font-size: 0.6rem;
			padding: 0.2em 0.5em;
		}
	}
</style>
