---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description="Thoughts on AI, development, music, and creative tech." />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<div class="header-content">
					<span class="breadcrumb">
						<span class="prompt">$</span> ls ./blog
					</span>
					<h1>Blog</h1>
					<p class="subtitle">
						Thoughts on AI, development, music, and creative tech.
					</p>
				</div>
			</header>
			
			<section class="posts-section">
				{posts.length === 0 ? (
					<div class="empty-state">
						<div class="terminal-box">
							<p><span class="prompt">$</span> find ./posts -type f</p>
							<p class="output">No posts found. Check back soon!</p>
						</div>
					</div>
				) : (
					<ul class="posts-list stagger">
						{posts.map((post, index) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`} class="post-link">
									{post.data.heroImage && (
										<div class="post-image">
											<Image 
												width={720} 
												height={360} 
												src={post.data.heroImage} 
												alt=""
												loading={index < 3 ? "eager" : "lazy"}
											/>
										</div>
									)}
									<div class="post-content">
										<div class="post-meta">
											<span class="post-number">#{String(posts.length - index).padStart(2, '0')}</span>
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h2 class="post-title">{post.data.title}</h2>
										<p class="post-description">{post.data.description}</p>
										<span class="read-more">
											<span class="arrow">&rarr;</span> Read article
										</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 900px;
	}
	
	/* Page Header */
	.page-header {
		padding: var(--space-xl) 0;
		margin-bottom: var(--space-lg);
		border-bottom: 1px solid var(--border-color);
	}
	
	.breadcrumb {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
		display: block;
		margin-bottom: var(--space-sm);
	}
	
	.breadcrumb .prompt {
		color: var(--accent-cyan);
		font-weight: bold;
	}
	
	.page-header h1 {
		margin-bottom: var(--space-sm);
	}
	
	.subtitle {
		font-size: 1.1rem;
		color: var(--text-secondary);
		margin: 0;
	}
	
	/* Empty State */
	.empty-state {
		padding: var(--space-xl);
		text-align: center;
	}
	
	.terminal-box {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		padding: var(--space-lg);
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		text-align: left;
	}
	
	.terminal-box .prompt {
		color: var(--accent-cyan);
		font-weight: bold;
	}
	
	.terminal-box .output {
		color: var(--text-muted);
		margin: var(--space-sm) 0 0 0;
	}
	
	/* Posts List */
	.posts-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}
	
	.post-item {
		border: 1px solid var(--border-color);
		border-radius: 12px;
		overflow: hidden;
		background: var(--bg-secondary);
		transition: all var(--transition-base);
	}
	
	.post-item:hover {
		border-color: var(--accent-cyan-dim);
		box-shadow: var(--glow-cyan);
		transform: translateY(-2px);
	}
	
	.post-link {
		display: grid;
		grid-template-columns: 280px 1fr;
		text-decoration: none;
		min-height: 200px;
	}
	
	.post-image {
		position: relative;
		overflow: hidden;
		background: var(--bg-tertiary);
	}
	
	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform var(--transition-slow);
	}
	
	.post-item:hover .post-image img {
		transform: scale(1.05);
	}
	
	.post-content {
		padding: var(--space-lg);
		display: flex;
		flex-direction: column;
	}
	
	.post-meta {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin-bottom: var(--space-sm);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	
	.post-number {
		color: var(--accent-cyan);
		font-weight: 700;
	}
	
	.post-title {
		font-size: 1.5rem;
		margin: 0 0 var(--space-sm) 0;
		color: var(--text-primary);
		line-height: 1.3;
		transition: color var(--transition-fast);
	}
	
	.post-item:hover .post-title {
		color: var(--accent-cyan);
	}
	
	.post-description {
		font-size: 0.95rem;
		color: var(--text-secondary);
		margin: 0;
		flex-grow: 1;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	.read-more {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--accent-cyan-dim);
		margin-top: var(--space-md);
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		transition: all var(--transition-fast);
	}
	
	.post-item:hover .read-more {
		color: var(--accent-cyan);
	}
	
	.read-more .arrow {
		transition: transform var(--transition-fast);
	}
	
	.post-item:hover .read-more .arrow {
		transform: translateX(4px);
	}
	
	/* Responsive */
	@media (max-width: 720px) {
		.post-link {
			grid-template-columns: 1fr;
		}
		
		.post-image {
			height: 180px;
		}
		
		.post-title {
			font-size: 1.25rem;
		}
	}
</style>
