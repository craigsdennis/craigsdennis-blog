---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<!-- Article Header -->
				<header class="article-header">
					<a href="/blog" class="back-link">
						<span class="arrow">&larr;</span> Back to blog
					</a>
					
					<div class="meta">
						<time datetime={pubDate.toISOString()}>
							<FormattedDate date={pubDate} />
						</time>
						{updatedDate && (
							<span class="updated">
								(Updated: <FormattedDate date={updatedDate} />)
							</span>
						)}
						<span class="separator">|</span>
						<span class="author">by {SITE_AUTHOR}</span>
					</div>
					
					<h1>{title}</h1>
					
					<p class="description">{description}</p>
				</header>
				
				<!-- Hero Image -->
				{heroImage && (
					<div class="hero-image">
						<Image 
							width={1200} 
							height={600} 
							src={heroImage} 
							alt=""
							loading="eager"
						/>
					</div>
				)}
				
				<!-- Article Content -->
				<div class="prose">
					<slot />
				</div>
				
				<!-- Article Footer -->
				<footer class="article-footer">
					<div class="share-prompt">
						<span class="prompt">$</span> echo "Thanks for reading!"
					</div>
					<a href="/blog" class="back-link">
						<span class="arrow">&larr;</span> Back to all posts
					</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 800px;
		padding-top: var(--space-lg);
	}
	
	article {
		animation: fadeIn 0.6s ease;
	}
	
	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	/* Article Header */
	.article-header {
		margin-bottom: var(--space-xl);
	}
	
	.back-link {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		margin-bottom: var(--space-lg);
		transition: color var(--transition-fast);
	}
	
	.back-link:hover {
		color: var(--accent-cyan);
	}
	
	.back-link .arrow {
		transition: transform var(--transition-fast);
	}
	
	.back-link:hover .arrow {
		transform: translateX(-4px);
	}
	
	.meta {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
		margin-bottom: var(--space-md);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
	}
	
	.meta time {
		color: var(--accent-cyan);
	}
	
	.updated {
		color: var(--text-muted);
		font-style: italic;
	}
	
	.separator {
		color: var(--border-color);
	}
	
	.author {
		color: var(--text-secondary);
	}
	
	.article-header h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		margin-bottom: var(--space-md);
		line-height: 1.15;
		background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-cyan) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	
	.description {
		font-size: 1.2rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}
	
	/* Hero Image */
	.hero-image {
		margin-bottom: var(--space-xl);
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--border-color);
	}
	
	.hero-image img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0;
	}
	
	/* Prose Content */
	.prose {
		color: var(--text-primary);
		line-height: 1.8;
	}
	
	.prose :global(h2) {
		margin-top: var(--space-xl);
		margin-bottom: var(--space-md);
		padding-bottom: var(--space-sm);
		border-bottom: 1px solid var(--border-subtle);
	}
	
	.prose :global(h3) {
		margin-top: var(--space-lg);
		margin-bottom: var(--space-sm);
	}
	
	.prose :global(p) {
		margin-bottom: var(--space-lg);
	}
	
	.prose :global(a) {
		color: var(--accent-cyan);
		text-decoration: underline;
		text-decoration-color: var(--accent-cyan-dim);
		text-underline-offset: 3px;
		transition: all var(--transition-fast);
	}
	
	.prose :global(a:hover) {
		color: var(--accent-amber);
		text-decoration-color: var(--accent-amber);
	}
	
	.prose :global(img) {
		border-radius: 8px;
		border: 1px solid var(--border-color);
		margin: var(--space-lg) 0;
	}
	
	.prose :global(pre) {
		margin: var(--space-lg) 0;
		border: 1px solid var(--border-color);
		position: relative;
	}
	
	.prose :global(pre)::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--accent-cyan), var(--accent-amber));
		border-radius: 8px 8px 0 0;
	}
	
	.prose :global(blockquote) {
		margin: var(--space-lg) 0;
		background: var(--bg-secondary);
	}
	
	.prose :global(ul), .prose :global(ol) {
		margin-bottom: var(--space-lg);
		padding-left: var(--space-lg);
	}
	
	.prose :global(li) {
		margin-bottom: var(--space-sm);
	}
	
	.prose :global(hr) {
		margin: var(--space-xl) 0;
	}
	
	.prose :global(table) {
		margin: var(--space-lg) 0;
		border: 1px solid var(--border-color);
		border-radius: 8px;
		overflow: hidden;
	}
	
	/* Article Footer */
	.article-footer {
		margin-top: var(--space-xl);
		padding-top: var(--space-xl);
		border-top: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-lg);
	}
	
	.share-prompt {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--text-muted);
		padding: var(--space-md) var(--space-lg);
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
	}
	
	.share-prompt .prompt {
		color: var(--accent-cyan);
		font-weight: bold;
	}
	
	/* Responsive */
	@media (max-width: 720px) {
		main {
			padding-top: var(--space-md);
		}
		
		.article-header h1 {
			font-size: 1.75rem;
		}
		
		.description {
			font-size: 1rem;
		}
		
		.meta {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-xs);
		}
		
		.separator {
			display: none;
		}
	}
</style>
